{
    "version": "7.3.17",
    "description": "Claude Code CLI with Google Antigravity OAuth integration (Zero API cost & On-Demand Proxy Lifecycle)",
    "homepage": "https://github.com/tuquet/tuquet-skills",
    "license": "MIT",
    "depends": "nodejs-lts",
    "architecture": {
        "64bit": {
            "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v7.3.17/CLIProxyAPI_7.3.17_windows_amd64.zip",
            "hash": "3a036376a7c04a8fe70d7335915aa79cc520f8fad72030ef8da43a64e50bc38b"
        }
    },
    "bin": "claude-agy.cmd",
    "persist": [
        "config",
        "data",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/router-for-me/CLIProxyAPI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/CLIProxyAPI/releases/download/v$version/CLIProxyAPI_$version_windows_amd64.zip"
            }
        }
    },
    "post_install": [
        "$cfgDir = Join-Path $dir 'config'",
        "$datDir = Join-Path $dir 'data'",
        "$logDir = Join-Path $dir 'logs'",
        "foreach ($d in @($cfgDir, $datDir, $logDir)) { if (-not (Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null } }",
        "",
        "# 1. Ensure Claude Code CLI (@anthropic-ai/claude-code) is installed",
        "if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {",
        "    Write-Host 'Installing @anthropic-ai/claude-code globally via npm...' -ForegroundColor Cyan",
        "    npm install -g @anthropic-ai/claude-code",
        "}",
        "",
        "# 2. Initialize config.yaml (KISS & YAGNI, sensitive-words for 429 prevention)",
        "$cfgFile = Join-Path $cfgDir 'config.yaml'",
        "if (-not (Test-Path $cfgFile)) {",
        "    $yamlDataDir = $datDir.Replace('\\', '/')",
        "    $cfgContent = @\"",
        "host: \"127.0.0.1\"",
        "port: 8318",
        "auth-dir: \"$yamlDataDir\"",
        "api-keys:",
        "  - \"sk-personal-claude-token\"",
        "remote-management:",
        "  disable-control-panel: true",
        "quota-exceeded:",
        "  switch-project: true",
        "  antigravity-credits: true",
        "debug: false",
        "antigravity:",
        "  sensitive-words:",
        "    - \"system-conventions\"",
        "    - \"system_conventions\"",
        "    - \"system-directive\"",
        "    - \"system_directive\"",
        "    - \"Claude Agent SDK\"",
        "    - \"Claude Code\"",
        "    - \"Anthropic\"",
        "    - \"claude\"",
        "    - \"API\"",
        "    - \"proxy\"",
        "\"@",
        "    Set-Content -Path $cfgFile -Value $cfgContent -Encoding UTF8",
        "}",
        "",
        "# 3. Initialize settings.env",
        "$setFile = Join-Path $cfgDir 'settings.env'",
        "if (-not (Test-Path $setFile)) {",
        "    $setContent = @\"",
        "PORT=8318",
        "AUTO_BYPASS_PERMISSIONS=true",
        "DEFAULT_MODEL=claude-sonnet-4-6",
        "\"@",
        "    Set-Content -Path $setFile -Value $setContent -Encoding UTF8",
        "}",
        "",
        "# 4. Configure Claude Trust & Onboarding in ~/.claude.json",
        "$claudeConfig = Join-Path $env:USERPROFILE '.claude.json'",
        "try {",
        "    $data = if (Test-Path $claudeConfig) { Get-Content $claudeConfig -Raw -Encoding UTF8 | ConvertFrom-Json } else { @{} }",
        "    $ht = @{}",
        "    if ($data) { foreach ($p in $data.PSObject.Properties) { $ht[$p.Name] = $p.Value } }",
        "    $ht['bypassPermissionsModeAccepted'] = $true",
        "    $ht['hasCompletedOnboarding'] = $true",
        "    if ($ht.ContainsKey('projects') -and $ht['projects']) {",
        "        foreach ($proj in $ht['projects'].PSObject.Properties) {",
        "            if ($proj.Value -is [PSCustomObject]) {",
        "                $proj.Value | Add-Member -MemberType NoteProperty -Name 'hasTrustDialogAccepted' -Value $true -Force",
        "            }",
        "        }",
        "    }",
        "    $ht | ConvertTo-Json -Depth 10 | Set-Content -Path $claudeConfig -Encoding UTF8",
        "} catch {}",
        "",
        "# 5. Multi-Source Google Antigravity Token Resolver",
        "$authTarget = Join-Path $datDir 'antigravity-auth.json'",
        "$candidates = @(",
        "    (Join-Path $env:USERPROFILE '.gemini\\antigravity-cli\\antigravity-oauth-token'),",
        "    (Join-Path $env:USERPROFILE '.gemini\\jetski-standalone-oauth-token'),",
        "    (Join-Path $env:USERPROFILE '.gemini\\oauth_creds.json')",
        ")",
        "foreach ($cand in $candidates) {",
        "    if (Test-Path $cand) {",
        "        try {",
        "            $raw = Get-Content $cand -Raw -Encoding UTF8 | ConvertFrom-Json",
        "            $tok = if ($raw.token) { $raw.token } else { $raw }",
        "            $idTok = if ($raw.id_token) { $raw.id_token } else { '' }",
        "            $acc = if ($tok.access_token) { $tok.access_token } else { $raw.access_token }",
        "            $ref = if ($tok.refresh_token) { $tok.refresh_token } else { $raw.refresh_token }",
        "            $exp = if ($tok.expiry) { $tok.expiry } else { $raw.expiry_date }",
        "            if ($acc -and $ref) {",
        "                $email = 'user@antigravity'",
        "                if ($idTok -and $idTok.Contains('.')) {",
        "                    try {",
        "                        $p2 = $idTok.Split('.')[1].Replace('-', '+').Replace('_', '/')",
        "                        while ($p2.Length % 4 -ne 0) { $p2 += '=' }",
        "                        $bytes = [Convert]::FromBase64String($p2)",
        "                        $pObj = [Text.Encoding]::UTF8.GetString($bytes) | ConvertFrom-Json",
        "                        if ($pObj.email) { $email = $pObj.email }",
        "                    } catch {}",
        "                }",
        "                $authObj = [PSCustomObject]@{",
        "                    type          = 'antigravity'",
        "                    email         = $email",
        "                    access_token  = $acc",
        "                    refresh_token = $ref",
        "                    expires_in    = 3600",
        "                    timestamp     = [int64](([DateTimeOffset]::UtcNow).ToUnixTimeMilliseconds())",
        "                    expired       = $exp",
        "                }",
        "                $authObj | ConvertTo-Json -Depth 5 | Set-Content -Path $authTarget -Encoding UTF8",
        "                Write-Host \"[OK] Synced Antigravity OAuth Token ($email)\" -ForegroundColor Green",
        "                break",
        "            }",
        "        } catch {}",
        "    }",
        "}",
        "",
        "# 6. Generate claude-agy.ps1 launcher",
        "$launcherPs1 = @\"",
        "param([Parameter(ValueFromRemainingArguments = `$true)][string[]]`$UserArgs)",
        "`$AppDir = `$PSScriptRoot",
        "`$Port = 8318",
        "`$AutoBypass = `$true",
        "`$DefaultModel = 'claude-sonnet-4-6'",
        "`$settingsFile = Join-Path `$AppDir 'config\\settings.env'",
        "if (Test-Path `$settingsFile) {",
        "    Get-Content `$settingsFile | ForEach-Object {",
        "        `$line = `$_.Trim()",
        "        if (`$line -and -not `$line.StartsWith('#') -and `$line.Contains('=')) {",
        "            `$parts = `$line.Split('=', 2)",
        "            if (`$parts[0].Trim() -eq 'PORT') { `$Port = [int]`$parts[1].Trim().Trim('\"') }",
        "            if (`$parts[0].Trim() -eq 'AUTO_BYPASS_PERMISSIONS') { `$AutoBypass = (`$parts[1].Trim().Trim('\"') -eq 'true') }",
        "            if (`$parts[0].Trim() -eq 'DEFAULT_MODEL') { `$DefaultModel = `$parts[1].Trim().Trim('\"') }",
        "        }",
        "    }",
        "}",
        "`$EnableBypass = `$AutoBypass",
        "`$ModelSpecified = `$false",
        "`$ProcessedArgs = [System.Collections.Generic.List[string]]::new()",
        "foreach (`$arg in `$UserArgs) {",
        "    switch (`$arg) {",
        "        '--bypass' { `$EnableBypass = `$true }",
        "        '-y' { `$EnableBypass = `$true }",
        "        '--no-bypass' { `$EnableBypass = `$false }",
        "        '--dangerously-skip-permissions' { `$EnableBypass = `$true }",
        "        default {",
        "            if (`$arg -eq '--model' -or `$arg -eq '-m' -or `$arg.StartsWith('--model=')) { `$ModelSpecified = `$true }",
        "            `$ProcessedArgs.Add(`$arg)",
        "        }",
        "    }",
        "}",
        "if (-not `$ModelSpecified -and `$DefaultModel) {",
        "    `$ProcessedArgs.Insert(0, `$DefaultModel)",
        "    `$ProcessedArgs.Insert(0, '--model')",
        "}",
        "if (`$EnableBypass) {",
        "    `$env:IS_SANDBOX = '1'",
        "    if (-not `$ProcessedArgs.Contains('--dangerously-skip-permissions')) {",
        "        `$ProcessedArgs.Insert(0, '--dangerously-skip-permissions')",
        "    }",
        "}",
        "`$env:ANTHROPIC_BASE_URL = \"http://127.0.0.1:`$Port\"",
        "`$env:ANTHROPIC_AUTH_TOKEN = 'sk-personal-claude-token'",
        "`$env:CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY = '1'",
        "function Test-Port([string]`$hostName, [int]`$portNum) {",
        "    `$c = New-Object System.Net.Sockets.TcpClient",
        "    try {",
        "        `$a = `$c.BeginConnect(`$hostName, `$portNum, `$null, `$null)",
        "        if (`$a.AsyncWaitHandle.WaitOne(200, `$false)) { `$c.EndConnect(`$a); return `$true }",
        "    } catch { return `$false } finally { `$c.Close() }",
        "    return `$false",
        "}",
        "`$ProxyProc = `$null",
        "`$Started = `$false",
        "if (-not (Test-Port '127.0.0.1' `$Port)) {",
        "    `$bin = Join-Path `$AppDir 'cli-proxy-api.exe'",
        "    `$cfg = Join-Path `$AppDir 'config\\config.yaml'",
        "    `$log = Join-Path `$AppDir 'logs\\proxy.log'",
        "    `$err = Join-Path `$AppDir 'logs\\proxy.err.log'",
        "    `$ProxyProc = Start-Process -FilePath `$bin -ArgumentList \"--config `\"`$cfg`\"\" -WindowStyle Hidden -PassThru -RedirectStandardOutput `$log -RedirectStandardError `$err",
        "    `$Started = `$true",
        "    `$retries = 0",
        "    while (-not (Test-Port '127.0.0.1' `$Port)) {",
        "        Start-Sleep -Milliseconds 200",
        "        `$retries++",
        "        if (`$retries -gt 25) {",
        "            Write-Host '>> [ERROR] Could not start proxy on port ' `$Port -ForegroundColor Red",
        "            if (`$ProxyProc -and -not `$ProxyProc.HasExited) { Stop-Process -Id `$ProxyProc.Id -Force -ErrorAction SilentlyContinue }",
        "            exit 1",
        "        }",
        "    }",
        "}",
        "try {",
        "    & claude @ProcessedArgs",
        "    `$exitCode = `$LASTEXITCODE",
        "} finally {",
        "    if (`$Started -and `$ProxyProc -and -not `$ProxyProc.HasExited) {",
        "        Stop-Process -Id `$ProxyProc.Id -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "exit `$exitCode",
        "\"@",
        "Set-Content -Path (Join-Path $dir 'claude-agy.ps1') -Value $launcherPs1 -Encoding UTF8",
        "",
        "# 7. Generate claude-agy.cmd wrapper for Scoop shim",
        "$cmdContent = \"@echo off`r`npowershell -NoProfile -ExecutionPolicy Bypass -File \"\"%~dp0claude-agy.ps1\"\" %*\"",
        "Set-Content -Path (Join-Path $dir 'claude-agy.cmd') -Value $cmdContent -Encoding ASCII"
    ],
    "post_uninstall": [
        "Get-Process cli-proxy-api -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ]
}
